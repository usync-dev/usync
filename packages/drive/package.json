{
  "name": "@usync/drive",
  "version": "0.2.8",
  "description": "Provider adapters and shared types for working with remote file storage.",
  "homepage": "https://github.com/usync-dev/usync/tree/main/packages/drive",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usync-dev/usync.git",
    "directory": "packages/drive"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./git": {
      "import": "./dist/providers/git/index.js",
      "types": "./dist/providers/git/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "del-cli dist tsconfig.tsbuildinfo",
    "build:types": "tsc",
    "build:js": "vite build",
    "test": "vitest --run",
    "build": "pnpm test && pnpm clean && pnpm build:js && pnpm build:types",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@usync/oauth2": "workspace:^",
    "isomorphic-git": "^1.42.0"
  }
}
