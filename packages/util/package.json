{
  "name": "@usync/util",
  "version": "0.1.0",
  "description": "Shared low-level utilities (base64/hex encoding helpers) for usync packages.",
  "homepage": "https://github.com/usync-dev/usync/tree/main/packages/util",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usync-dev/usync.git",
    "directory": "packages/util"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "del-cli dist tsconfig.tsbuildinfo",
    "build:types": "tsc",
    "build:js": "vite build",
    "build": "pnpm clean && pnpm build:js && pnpm build:types",
    "test": "vitest --run",
    "prepublishOnly": "pnpm build"
  }
}
